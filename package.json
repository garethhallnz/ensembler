{
  "name": "ensembler",
  "version": "1.0.1",
  "description": "A self-hosted media center orchestrator — run the *arr stack and a media server without Docker or the command line.",
  "author": "Gareth Hall (https://github.com/garethhallnz)",
  "license": "MIT",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/garethhallnz/ensembler.git"
  },
  "bugs": {
    "url": "https://github.com/garethhallnz/ensembler/issues"
  },
  "type": "module",
  "main": "electron.js",
  "homepage": "./",
  "scripts": {
    "dev": "concurrently -k -n backend,frontend -c green,cyan \"npm run backend\" \"npm run frontend\"",
    "dev-electron": "concurrently -k -n vite,electron -c cyan,magenta \"npm run frontend\" \"wait-on tcp:127.0.0.1:5180 && NODE_ENV=development electron .\"",
    "electron": "electron .",
    "build": "./build.sh",
    "electron-build": "npm run build && electron-builder",
    "electron-dist": "npm run build && electron-builder --publish=never",
    "install-deps": "npm install && cd backend && npm install && cd ../frontend && npm install",
    "test": "cd backend && npm test && cd ../frontend && npm test",
    "lint": "cd backend && npm run lint && cd ../frontend && npm run lint",
    "frontend": "cd frontend && npm run dev",
    "backend": "cd backend && npm run dev",
    "prepare": "husky"
  },
  "lint-staged": {
    "backend/**/*.ts": "eslint --fix --config backend/eslint.config.mjs",
    "frontend/**/*.{ts,tsx}": "eslint --fix --config frontend/eslint.config.js"
  },
  "dependencies": {
    "node-docker-api": "^1.1.22"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "electron": "^36.2.0",
    "electron-builder": "^25.1.8",
    "eslint": "^9.39.5",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "wait-on": "^8.0.2"
  },
  "build": {
    "appId": "com.ensembler.app",
    "productName": "Ensembler",
    "publish": {
      "provider": "github",
      "owner": "garethhallnz",
      "repo": "ensembler"
    },
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "frontend/dist/**/*",
      "electron.js",
      "preload.js",
      "node_modules/**/*"
    ],
    "extraResources": [
      {
        "from": "backend/dist/server.bundle.js",
        "to": "backend/server.bundle.js"
      }
    ],
    "mac": {
      "category": "public.app-category.utilities",
      "icon": "assets/icon.icns",
      "target": {
        "target": "dmg",
        "arch": [
          "x64",
          "arm64"
        ]
      }
    },
    "win": {
      "icon": "assets/icon.ico",
      "target": {
        "target": "nsis",
        "arch": [
          "x64"
        ]
      }
    },
    "linux": {
      "icon": "assets/icon.png",
      "target": {
        "target": "AppImage",
        "arch": [
          "x64"
        ]
      },
      "category": "Utility"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
